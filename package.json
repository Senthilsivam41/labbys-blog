{
  "name": "labs-built-by-sendil",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next dev",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "emulators": "firebase emulators:start --project demo-labbys",
    "emulators:test": "firebase emulators:exec --project demo-labbys --only auth,firestore \"npm test\"",
    "admin:claim": "node --env-file=.env functions/scripts/set-admin-claim.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
