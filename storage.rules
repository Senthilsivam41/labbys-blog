rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() { return request.auth != null && request.auth.token.email == "OWNER_EMAIL_REPLACE_ME"; }
    match /drafts/{ownerId}/{allPaths=**} { allow read, write: if isOwner() && request.auth.uid == ownerId && request.resource.size < 25 * 1024 * 1024; }
    match /public/profile/{allPaths=**} { allow read: if true; allow write: if isOwner() && request.resource.size < 10 * 1024 * 1024; }
    match /public/{allPaths=**} { allow read: if true; allow write: if false; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
